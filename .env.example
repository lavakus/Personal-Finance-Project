# ── Supabase (from your project settings) ─────────────────────────────
# Leave unset to run the apps in DEMO MODE (sample data, clearly labeled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side ONLY (Vercel env / GitHub Actions secrets). NEVER NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Scheduled jobs ─────────────────────────────────────────────────────
# Bearer secret protecting /api/jobs/* endpoints.
CRON_SECRET=

# ── Mobile (apps/mobile/.env) ──────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
